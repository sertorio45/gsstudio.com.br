{"file":"Blog.vue2.mjs","mappings":";;;;;;;;AAgDA,UAAM,EAAE,MAAM,UAAU,SAAS,OAAO,aAAkB,CAAA,QAAA,SAAA,IAAAA,iBAAA,YAAA;AAAA,MACxD;AAAA,MACA,YAAY;AACJ,cAAA,WAAW,MAAM,OAA2L,gJAAgJ;AAAA,UAChW,QAAQ;AAAA,UACR,SAAS;AAAA,YACP,gBAAgB;AAAA,UAAA;AAAA,QAClB,CACD;AACM,eAAA,SAAS,KAAK,IAAI,CAAY,YAAA;;AAAA;AAAA,YACnC,GAAG;AAAA,YACH,kBAAgB,aAAQ,cAAR,mBAAmB,oBAAmB;AAAA,UAAA;AAAA,SACtD;AAAA,MAAA;AAAA,IAEN,CAAA;;;;;;;;;;;;;;;;;;;;;;;;;","names":["_withAsyncContext"],"sources":["../../../../components/Blog.vue"],"sourcesContent":["<template>\n  <section class=\"my-5 py-5 min-vh-100 justify-content-center align-content-center bg-light\" id=\"blog\">\n    <div class=\"container my-5\">\n      <div class=\"row\">\n        <h2 class=\"text-center\">Blog</h2>\n        \n        <!-- Skeleton Cards -->\n        <div v-if=\"pending\" class=\"col-md-3 my-5\" v-for=\"n in 4\" :key=\"n\">\n          <div class=\"card\">\n            <div class=\"card-body\">\n              <div class=\"mb-2\">\n                <div class=\"skeleton skeleton-category\"></div>\n              </div>\n              <div class=\"skeleton skeleton-title\"></div>\n            </div>\n          </div>\n        </div>\n\n        <!-- Lista de Artigos -->\n        <div v-else-if=\"articles && articles.length > 0\" class=\"col-sm-3 my-2\" v-for=\"article in articles\" :key=\"article.id\">\n          <div class=\"card\">\n            <div class=\"card-body\">\n              <div class=\"mb-2\">\n                <span class=\"article-category\">{{ article.category_title }}</span>\n              </div>\n              <a :href=\"article.slug\">\n                {{ article.title }}\n              </a>\n            </div>\n          </div>\n        </div>\n\n        <!-- Nenhum Artigo Encontrado -->\n        <div v-else class=\"col text-center my-5\">\n          <p class=\"text-muted\">Nenhum artigo encontrado.</p>\n        </div>\n      </div>\n      \n      <div class=\"row my-3\">\n        <div class=\"col d-flex align-content-center justify-content-center\">\n          <a href=\"/blog\" class=\"btn btn-primary\">Ver mais artigos</a>\n        </div>\n      </div>\n    </div>\n  </section>\n</template>\n\n<script setup lang=\"ts\">\nconst { data: articles, pending, error, refresh } = await useAsyncData(\n  \"articles\",\n  async () => {\n    const response = await $fetch<{ data: Array<{ id: number, title: string, meta_keywords: string, meta_description: string, content: string, slug: string, categorie: { id: number, title_categorie: string } }> }>(\"https://painel.gsadmin.app/items/articles?fields=id,title,meta_keywords,meta_description,content,slug,categorie.id,categorie.title_categorie\", {\n      method: \"GET\",\n      headers: {\n        \"Content-Type\": \"application/json\"\n      }\n    });\n    return response.data.map(article => ({\n      ...article,\n      category_title: article.categorie?.title_categorie || \"Sem categoria\",\n    }));\n  },\n);\n\n\n</script>"],"version":3}